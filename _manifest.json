{
  "manifest_version": 2,
  "id": "local.chatgpt-maibot-connect",
  "version": "0.2.3",
  "name": "ChatGPT-MaiBot-connect-plugin",
  "description": "通过 Sign in with ChatGPT 提供 Responses、GPT 内置搜索与公开网页正文读取",
  "author": {
    "name": "Caeruvis",
    "url": "https://github.com/Caeruvis"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Caeruvis/ChatGPT-MaiBot-connect-plugin"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.4.0"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0,<1"
    },
    {
      "type": "python_package",
      "name": "PyJWT",
      "version_spec": ">=2.13.0,<3"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=50.0.0"
    },
    {
      "type": "python_package",
      "name": "jsonschema",
      "version_spec": ">=4.26.0,<5"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.12,<5"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.14.3,<4"
    }
  ],
  "plugin_type": "provider",
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "llm_providers": [
    {
      "client_type": "openai_chatgpt_plan_siwc",
      "name": "ChatGPT Plan",
      "description": "Sign in with ChatGPT Responses Provider",
      "version": "0.2.3"
    }
  ]
}
