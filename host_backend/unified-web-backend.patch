+"""插件搜索的实际 Host 路由、SDK 能力与结果预览契约。"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import asyncio
+import sys
+
+import pytest
+
+from src.core.tooling import ToolInvocation
+from src.plugin_runtime.capabilities import web
+from src.plugin_runtime.host.api_registry import APIRegistry
+from src.web_search.adapters.plugin import call_plugin_api
+from src.web_search.config import WebRuntimeConfig
+from src.web_search.models import WebSearchError
+from src.web_search.provider import WebSearchToolProvider
+from src.web_search.service import WebSearchService
+
+
+def config():
+    return WebRuntimeConfig(
+        enabled=True,
+        search="gpt",
+        fetch="gpt",
+        services={"gpt": {"adapter": "plugin", "plugin_id": "local.chatgpt-maibot-connect", "timeout": 270}},
+    )
+
+
+@pytest.fixture
+def runtime(monkeypatch):
+    registry = APIRegistry()
+    registry.register_api(
+        "search", "local.chatgpt-maibot-connect", {"public": True, "version": "1", "handler_name": "search_handler"}
+    )
+    registry.register_api(
+        "fetch", "local.chatgpt-maibot-connect", {"public": True, "version": "1", "handler_name": "fetch_handler"}
+    )
+    supervisor = SimpleNamespace(api_registry=registry, invoke_api=AsyncMock())
+    monkeypatch.setitem(
+        sys.modules,
+        "src.plugin_runtime.integration",
+        SimpleNamespace(get_plugin_runtime_manager=lambda: SimpleNamespace(supervisors=[supervisor])),
+    )
+    return supervisor
+
+
+def response(data):
+    return SimpleNamespace(error=None, payload={"success": True, "result": data})
+
+
+def search_result():
+    return {
+        "content_kind": "search_results",
+        "results": [
+            {
+                "title": "来源",
+                "url": "https://example.com",
+                "snippet": "[GPT 生成摘要] 资料",
+                "summary": "[GPT 生成摘要] 资料",
+                "published_at": None,
+            }
+        ],
+    }
+
+
+@pytest.mark.asyncio
+async def test_chat_and_mailife_capability_use_same_plugin_route(runtime, monkeypatch):
+    runtime.invoke_api.return_value = response(search_result())
+    service = WebSearchService(None)
+    settings = config()
+    provider = WebSearchToolProvider(service, lambda: settings)
+    result = await provider.invoke(ToolInvocation(tool_name="web_search", session_id="chat", arguments={"query": "q"}))
+    assert result.success and result.structured_content["results"][0]["published_at"] is None
+    assert "result_id" in result.structured_content
+    monkeypatch.setattr(web, "get_config", lambda: settings)
+    monkeypatch.setattr(web, "get_service", lambda: service)
+    capability = await web.call("maibot-community.mai-life", "web.search", {"query": "q", "max_results": 2})
+    assert capability["result"]["results"][0]["snippet"] == "[GPT 生成摘要] 资料"
+    assert "result_id" not in capability["result"]
+    args = runtime.invoke_api.await_args.kwargs
+    assert args["plugin_id"] == "local.chatgpt-maibot-connect"
+    assert args["component_name"] == "search_handler"
+    assert args["timeout_ms"] == 270000
+    assert args["args"] == {"query": "q", "max_results": 2}
+
+
+@pytest.mark.asyncio
+async def test_page_text_is_passed_without_model_summarization(runtime):
+    runtime.invoke_api.return_value = response(
+        {"content_kind": "page_text", "url": "https://example.com", "title": "Page", "content": "真实正文" * 2000}
+    )
+    result = await WebSearchService(None).execute(
+        config(), ToolInvocation(tool_name="web_fetch", arguments={"url": "https://example.com"})
+    )
+    assert result.content == "真实正文" * 2000
+    assert runtime.invoke_api.await_args.kwargs["component_name"] == "fetch_handler"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("public,enabled", [(False, True), (True, False)])
+async def test_private_and_disabled_apis_are_not_invoked(runtime, public, enabled):
+    entry = runtime.api_registry.get_api("local.chatgpt-maibot-connect", "search", version="1")
+    entry.public, entry.enabled = public, enabled
+    with pytest.raises(WebSearchError, match="不可用"):
+        await call_plugin_api(config().services["gpt"], "search", {"query": "q"})
+    runtime.invoke_api.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_backend_itself_cannot_reenter_ctx_web(runtime):
+    with pytest.raises(WebSearchError, match="自身"):
+        await WebSearchService(None).execute(
+            config(),
+            ToolInvocation(
+                tool_name="web_search", arguments={"query": "q"}, metadata={"plugin_id": "local.chatgpt-maibot-connect"}
+            ),
+        )
+    runtime.invoke_api.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload",
+    [
+        SimpleNamespace(error={"message": "SECRET TOKEN"}, payload={}),
+        SimpleNamespace(error=None, payload={"success": False, "result": "SECRET TOKEN"}),
+        response({"content_kind": "page_summary", "content": "generated"}),
+    ],
+)
+async def test_plugin_failures_and_generated_page_summaries_are_rejected(runtime, payload):
+    runtime.invoke_api.return_value = payload
+    with pytest.raises(WebSearchError) as caught:
+        await WebSearchService(None).execute(
+            config(), ToolInvocation(tool_name="web_fetch", arguments={"url": "https://example.com"})
+        )
+    assert "SECRET" not in str(caught.value)
+
+
+@pytest.mark.asyncio
+async def test_empty_search_is_success_and_timeout_cancels():
+    caller = AsyncMock(return_value={"content_kind": "search_results", "results": []})
+    service = WebSearchService(None, plugin_caller=caller)
+    assert (
+        await service.execute(config(), ToolInvocation(tool_name="web_search", arguments={"query": "q"}))
+    ).results == []
+    cancelled = asyncio.Event()
+
+    async def slow(*args):
+        try:
+            await asyncio.Event().wait()
+        finally:
+            cancelled.set()
+
+    caller.side_effect = slow
+    settings = config()
+    settings.services["gpt"].timeout = 0.01
+    with pytest.raises(WebSearchError, match="超过"):
+        await service.execute(settings, ToolInvocation(tool_name="web_search", arguments={"query": "q"}))
+    assert cancelled.is_set()
